{
  "manifest_version": 3,
  "name": "MyDocx",
  "description": "Organizador Google Docs com Google Drive, pastas reais e interface inspirada no macOS.",
  "version": "0.3.0",
  "permissions": [
    "storage",
    "identity"
  ],
  "action": {
    "default_title": "Abrir MyDocx"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.css",
        "dashboard.js",
        "cloud.html",
        "cloud.css",
        "cloud.js"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.metadata",
      "https://www.googleapis.com/auth/drive.file"
    ]
  }
}
